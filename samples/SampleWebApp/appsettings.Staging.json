{
    "ConnectionStrings": {
    },
    "Logging": {
        "LogLevel": {
            "Default": "Warning",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore.Database.Command": "Error"
        }
    },
    "AllowedHosts": "*",
    "JwtSettings": {
        "Issuer": "https://localhost:13434/api/",
        "Audience": "https://localhost:13434/ui/",
        "TokenExpires": "600000",
        "RefreshTokenExpires": "604800000"
    },
    "CorsSettings": {
        "AllowedOrigins": [
            "https://marketplaceapi.microsoft.com",
            "https://partner.microsoft.com",
            "https://appsource.microsoft.com",
            "https://management.azure.com",
            "https://portal.azure.com"
        ],
        "AllowedMethods": [
            "GET",
            "POST",
            "PATCH",
            "OPTIONS"
        ],
        "AllowedHeaders": [
            "Content-Type",
            "Authorization",
            "X-Requested-With",
            "Accept",
            "Origin"
        ]
    },
    "CompanyRetentionSettingsOptions": {
        "CompanyRetentionDays": 30,
        "ReminderBeforeDays": [ 5, 1 ]
    },
    "MaxFileSizeInMB": 10,
    "AppSettings": {
      "Version": "1.0.0"
    }
}
